{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sloik/dodona/protocol/provider-manifest.schema.json",
  "title": "Provider manifest",
  "description": "What a provider announces in the opening exchange of a session.",
  "type": "object",
  "required": [
    "protocol",
    "name",
    "version",
    "capabilities",
    "trusted_base"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Protocol version the provider speaks. Same major version is required."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "capability"
        ],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "granularity": {
            "enum": [
              "definition",
              "module",
              "file"
            ],
            "description": "definition.index only."
          },
          "platform_independent": {
            "type": "boolean",
            "default": false,
            "description": "True removes the platform from the evidence key. A claim, listed in the trusted base."
          },
          "max_reproducibility": {
            "$ref": "common.schema.json#/$defs/reproducibility",
            "description": "Strongest level this capability can meet."
          },
          "evidence_class": {
            "enum": [
              "proof",
              "bounded-model-check",
              "test",
              "mapping-only"
            ],
            "description": "obligation.check and conformance.check only."
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "constraint"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "constraint": {
            "type": "string"
          }
        }
      },
      "description": "External tools the provider needs. Resolved and pinned by a tool.resolve provider; the provider never finds tools itself."
    },
    "trusted_base": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assumptions a result from this provider rests on, beyond the kernel's own."
    }
  }
}
