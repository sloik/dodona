{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sloik/dodona/protocol/provider-manifest.schema.json",
  "title": "Provider manifest",
  "description": "What a provider announces in the opening exchange of a session.",
  "type": "object",
  "required": [
    "protocol",
    "name",
    "version",
    "capabilities",
    "trusted_base"
  ],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability"
        ],
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "granularity": {
            "enum": [
              "definition",
              "module",
              "file"
            ],
            "description": "definition.index only."
          },
          "text_files": {
            "type": "boolean",
            "description": "definition.index and decision.index: whether claimed files are text and subject to the project's line-ending rule."
          },
          "determinism": {
            "enum": [
              "deterministic",
              "seeded",
              "nondeterministic"
            ],
            "description": "Whether equal inputs give equal results. seeded: only with the seed fixed in configuration."
          },
          "platform_independent": {
            "type": "boolean",
            "default": false,
            "description": "A claim that results do not depend on the platform. Never removes the platform from a record; honoured only after it has been checked on two platforms."
          },
          "max_reproducibility": {
            "$ref": "common.schema.json#/$defs/reproducibility"
          },
          "comparable_summary": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Summary fields compared at reproducibility level evidence. Timing fields must not be listed."
          },
          "strength": {
            "$ref": "common.schema.json#/$defs/strength",
            "description": "obligation.check and conformance.check only."
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "constraint"
        ],
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "constraint": {
            "type": "string"
          }
        }
      },
      "description": "Tools the provider needs. Resolved and pinned by a tool.resolve provider together with everything they require; the provider never finds tools itself."
    },
    "trusted_base": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Standing assumptions a result from this provider rests on, beyond the kernel's own list."
    }
  }
}
