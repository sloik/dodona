{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sloik/dodona/protocol/evidence-record.schema.json",
  "title": "Evidence record",
  "description": "One entry in the ledger. Written only by the kernel.",
  "type": "object",
  "required": [
    "record",
    "obligation",
    "core_key",
    "platform",
    "verdict",
    "inputs",
    "provider",
    "executor",
    "isolation",
    "origin",
    "runs",
    "kind"
  ],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "record": {
      "$ref": "common.schema.json#/$defs/identity",
      "description": "Hash of the canonical encoding of this record without this field and without signature."
    },
    "previous": {
      "$ref": "common.schema.json#/$defs/identity",
      "description": "The record this writer wrote before this one. Gives a causal order without a counter or a clock."
    },
    "obligation": {
      "$ref": "common.schema.json#/$defs/identity"
    },
    "core_key": {
      "$ref": "common.schema.json#/$defs/identity",
      "description": "Identity of the object described under $defs/core_key_preimage, over the canonical encoding. Recomputed by the kernel whenever the record is read."
    },
    "platform": {
      "$ref": "common.schema.json#/$defs/platform",
      "description": "Where the check executed, as reported by the executor. Second part of the evidence key."
    },
    "verdict": {
      "enum": [
        "passed",
        "failed"
      ],
      "description": "Only reusable verdicts are written to the ledger. Other outcomes are reported and logged, not recorded as evidence."
    },
    "inputs": {
      "type": "object",
      "required": [
        "specified_by",
        "targets",
        "closure",
        "tools",
        "config",
        "expect"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "specified_by": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identity"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identity"
          }
        },
        "closure": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identity"
          },
          "description": "Everything reachable over depends-on, sorted by UTF-8 bytes."
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "produced_by_core_key"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "$ref": "common.schema.json#/$defs/identity"
              },
              "produced_by_core_key": {
                "$ref": "common.schema.json#/$defs/identity"
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "digest"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/identity"
              }
            }
          },
          "description": "Whole requirement closure, including runtimes."
        },
        "config": {
          "$ref": "common.schema.json#/$defs/identity",
          "description": "Hash of bounds, flags, seeds, worker counts and limits."
        },
        "declared": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identity"
          },
          "description": "Further inputs the provider declared before submission."
        },
        "expect": {
          "enum": [
            "holds",
            "violated"
          ],
          "description": "What the obligation expects. Part of the core key."
        },
        "mapping": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identity"
          },
          "description": "For conformance: the files that say which part of the implementation answers to which part of the specification. A set, sorted."
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "version",
        "protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        }
      }
    },
    "executor": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "description": "Every tool run this verdict was derived from, in order.",
      "items": {
        "type": "object",
        "required": [
          "exit_status",
          "output",
          "tools_ran"
        ],
        "additionalProperties": false,
        "properties": {
          "exit_status": {
            "type": "integer"
          },
          "output": {
            "$ref": "common.schema.json#/$defs/identity",
            "description": "Digest of the raw captured output."
          },
          "tools_ran": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "digest"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/identity"
                }
              }
            },
            "description": "The tools the executor reports it actually ran."
          },
          "handle": {
            "type": "string"
          }
        }
      }
    },
    "strength": {
      "$ref": "common.schema.json#/$defs/strength",
      "description": "Required for records of checks and of conformance. A build record has none: building shows nothing about correctness."
    },
    "isolation": {
      "$ref": "common.schema.json#/$defs/isolation"
    },
    "trusted_base": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assumptions specific to this result, such as axioms a proof used."
    },
    "summary": {
      "type": "object",
      "description": "Provider-defined. Only fields the manifest lists as comparable are compared across platforms."
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identity"
      },
      "description": "Logs, counterexamples and outputs, held by a store.blob provider. A failure found by a tool carries its counterexample or diagnostic here."
    },
    "origin": {
      "type": "object",
      "required": [
        "writer"
      ],
      "additionalProperties": false,
      "properties": {
        "writer": {
          "type": "string",
          "description": "Identifier of the kernel installation that wrote the record."
        },
        "signature": {
          "type": "string",
          "description": "Required for a record to be reusable anywhere but where it was written."
        }
      }
    },
    "kind": {
      "enum": [
        "check",
        "build",
        "conformance",
        "reproducibility"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "identity": {
            "$ref": "common.schema.json#/$defs/identity"
          }
        }
      },
      "description": "For a build: the artifacts produced."
    },
    "deterministic": {
      "type": "boolean",
      "description": "For a build: whether the provider declares the outputs byte-identical for equal inputs."
    }
  },
  "$defs": {
    "core_key_preimage": {
      "type": "object",
      "description": "The exact object whose identity is the core key. Every array in it is a set, sorted as the canonical encoding says, except where order is stated to matter.",
      "required": [
        "obligation",
        "kind",
        "inputs",
        "provider"
      ],
      "additionalProperties": false,
      "properties": {
        "obligation": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "kind": {
          "enum": [
            "check",
            "build",
            "conformance",
            "reproducibility"
          ]
        },
        "inputs": {
          "description": "The record's `inputs` object, whole, without `platform`."
        },
        "provider": {
          "type": "object",
          "required": [
            "name",
            "version",
            "protocol"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "protocol": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
