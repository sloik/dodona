{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sloik/dodona/protocol/act-record.schema.json",
  "title": "Act record",
  "description": "One act that rests on someone's judgement, with what is needed to grade how separate the actor was from the work (decision 0024). The level, and how well each fact is supported, are worked out by the kernel and are never taken from the record.",
  "type": "object",
  "required": [
    "ticket",
    "kind",
    "target",
    "actor",
    "worker"
  ],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "ticket": {
      "type": "string",
      "description": "Issued by the kernel before the attempt. An issued ticket with no closing record counts as a failed attempt."
    },
    "kind": {
      "enum": [
        "confirm-baseline",
        "match-check",
        "grant-amendment",
        "close-deferred",
        "change-policy"
      ]
    },
    "target": {
      "$ref": "common.schema.json#/$defs/identity",
      "description": "Identity of what was judged."
    },
    "result": {
      "enum": [
        "agreed",
        "refused"
      ],
      "description": "Absent while the attempt is open."
    },
    "actor": {
      "type": "object",
      "required": [
        "id",
        "session"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "started_by": {
          "type": "string",
          "description": "Who started the actor. The worker here means at most helper."
        },
        "make": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vendor": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "description": "Model family and vendor, as reported by whatever ran the actor. A deterministic tool is not a make."
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "make": {
          "type": "object"
        }
      }
    },
    "brief": {
      "type": "object",
      "required": [
        "issued_by",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "issued_by": {
          "enum": [
            "kernel",
            "owner",
            "worker",
            "other"
          ]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/identity"
        }
      }
    },
    "given": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "work",
              "criteria",
              "brief",
              "known-wrong",
              "known-right",
              "other"
            ]
          },
          "content": {
            "$ref": "common.schema.json#/$defs/identity"
          }
        }
      },
      "description": "Everything placed in the actor's context or made readable to it. Anything marked `other`, or anything the worker wrote about its own reasoning, means at most helper."
    },
    "fresh_context": {
      "type": "boolean",
      "description": "The actor started with no history from the worker."
    },
    "known_bad": {
      "type": "object",
      "required": [
        "wrong",
        "right",
        "supplied_by",
        "criterion",
        "rejected_wrong",
        "accepted_right"
      ],
      "additionalProperties": false,
      "properties": {
        "wrong": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "right": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "supplied_by": {
          "enum": [
            "kernel",
            "owner"
          ]
        },
        "criterion": {
          "type": "string"
        },
        "rejected_wrong": {
          "type": "boolean"
        },
        "accepted_right": {
          "type": "boolean"
        }
      },
      "description": "A case known to be wrong and one known to be right, given to the actor unlabelled. Needed for tested."
    },
    "attempt": {
      "type": "object",
      "required": [
        "number",
        "prior"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "prior": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tickets of earlier attempts on the same target and kind."
        }
      }
    },
    "transcript": {
      "$ref": "common.schema.json#/$defs/identity"
    },
    "attestation": {
      "type": "object",
      "required": [
        "harness",
        "key",
        "signature",
        "covers"
      ],
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "A harness signature over the listed fields. Fields it does not cover fall back to declared."
    },
    "lineage": {
      "type": "object",
      "required": [
        "intent",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string"
        },
        "criterion": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "description": "What attempts are counted along: the same criterion of the same intent, whatever the content of the work."
    }
  }
}
