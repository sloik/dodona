      "sha256": "3f2a9ad2ba83bf98853d66b972dc3971c8eacca6fbbc25641303f71e36458f38"
    },
    {
      "name": "largest and smallest integers",
      "value": [
        9007199254740991,
        -9007199254740991
      ],
      "canonical": "[9007199254740991,-9007199254740991]",
      "sha256": "84bad60c1793654a7cdca854230af90af531ecc8f7656e2c7b2bd91890017b37"
    },
    {
      "name": "short escapes",
      "value": {
        "s": "\b\t\n\f\r\"\\"
