{
  "about": "Test vectors for the canonical encoding (protocol/canonical-encoding.md). `value` is the input; `canonical` is the exact text; `sha256` is the hash of its UTF-8 bytes. `reject` holds input texts that must be refused, with the reason.",
  "accept": [
    {
      "name": "empty object",
      "value": {},
      "canonical": "{}",
      "sha256": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
    },
    {
      "name": "empty array",
      "value": [],
      "canonical": "[]",
