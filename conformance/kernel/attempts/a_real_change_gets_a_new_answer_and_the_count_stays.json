        "cap": null,
        "attempts": 1
      }
    },
    {
      "do": {
        "close": {
          "ticket": "t1",
          "result": "refused"
        }
      },
      "expect": {
        "result": "refused",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
