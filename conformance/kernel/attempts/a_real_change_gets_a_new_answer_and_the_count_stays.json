        "result": "none",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
    },
    {
      "do": {
        "take": {
          "as": "t2"
        }
      },
      "expect": {
        "result": "refused",
        "shopped": false,
        "cap": null,
        "attempts": 2
      }
    },
    {
      "do": {
        "close": {
          "ticket": "t2",
          "result": "agreed"
