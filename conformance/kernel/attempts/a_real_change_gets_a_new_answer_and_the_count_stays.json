{
  "kind": "attempts",
  "name": "a_real_change_gets_a_new_answer_and_the_count_stays",
  "claim": "C35",
  "covers": [
    "attempts/mutant_cap_on_shopping_only"
  ],
  "why": "When the thing judged changes, the old refusal no longer decides the answer on the new target. It is still part of the line: an agreement after it is retried and capped at helper, because a kernel cannot tell a real fix from a trivial change made to get a fresh try (decision 0024). The number of attempts along the line is still shown.",
  "steps": [
    {
      "do": {
        "take": {
          "as": "t1"
        }
      },
      "expect": {
        "result": "refused",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
    },
    {
      "do": {
        "close": {
          "ticket": "t1",
          "result": "refused"
        }
      },
      "expect": {
        "result": "refused",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
    },
    {
      "do": {
        "change_target": {}
      },
      "expect": {
        "result": "none",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
    },
    {
      "do": {
        "take": {
          "as": "t2"
        }
      },
      "expect": {
        "result": "refused",
        "shopped": false,
        "cap": null,
        "attempts": 2
      }
    },
    {
      "do": {
        "close": {
          "ticket": "t2",
          "result": "agreed"
        }
      },
      "expect": {
        "result": "agreed",
        "shopped": false,
        "cap": "helper",
        "attempts": 2
      }
    }
  ]
}
