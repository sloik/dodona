{
  "kind": "attempts",
  "name": "clean_agreement",
  "claim": "C35",
  "covers": [
    "attempts/reach_agreed"
  ],
  "why": "One attempt, closed as agreed, is an agreement. Until it is closed it counts as a failure.",
  "steps": [
    {
      "do": {
        "take": {
          "as": "t1"
        }
      },
      "expect": {
        "result": "refused",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
    },
    {
      "do": {
        "close": {
          "ticket": "t1",
          "result": "agreed"
        }
      },
      "expect": {
        "result": "agreed",
        "shopped": false,
        "cap": null,
        "attempts": 1
      }
    }
  ]
}
