{
  "kind": "tree",
  "name": "adding_a_child_returns_to_draft",
  "claim": "C34",
  "covers": [
    "tree/mutant_add_keeps_confirmation"
  ],
  "why": "Adding a child changes what the parent means, so it is a draft until confirmed.",
  "policy": {
    "min_hard_gates": 1
  },
  "root": {
    "gate": "hard"
  },
  "children": {
    "k1": {
      "gate": "hard"
    }
  },
  "steps": [
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "root",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "k1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "add": {
          "child": "k2",
          "gate": "hard"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    }
  ]
}
