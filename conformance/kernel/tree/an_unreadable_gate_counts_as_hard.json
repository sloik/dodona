{
  "kind": "tree",
  "name": "an_unreadable_gate_counts_as_hard",
  "claim": "C34",
  "covers": [],
  "why": "A gate nobody can read counts as hard, so a mistake in writing one can only make delivery harder: a soft child edited to `Hard` must now pass, and a child added with gate `deferred` must pass too.",
  "policy": {
    "min_hard_gates": 1
  },
  "root": {
    "gate": "hard"
  },
  "children": {
    "k1": {
      "gate": "soft"
    }
  },
  "steps": [
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "unguarded"
      }
    },
    {
      "do": {
        "edit": {
          "node": "k1",
          "to": "Hard"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "root",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "k1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "add": {
          "child": "k2",
          "gate": "deferred"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "k2",
          "status": "passed"
        }
      },
      "expect": {
        "status": "delivered"
      }
    }
  ]
}
