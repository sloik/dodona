{
  "kind": "tree",
  "name": "nothing_unconfirmed_is_delivered",
  "claim": "C34",
  "covers": [
    "tree/mutant_unconfirmed_delivered"
  ],
  "why": "A tree whose every hard gate passes is still a draft until the owner confirms it.",
  "policy": {
    "min_hard_gates": 1
  },
  "root": {
    "gate": "hard"
  },
  "children": {
    "k1": {
      "gate": "hard"
    }
  },
  "steps": [
    {
      "do": {
        "check": {
          "node": "root",
          "status": "passed"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "check": {
          "node": "k1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "edit": {
          "node": "k1",
          "to": "soft"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "edit": {
          "node": "k1",
          "to": "hard"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "delivered"
      }
    }
  ]
}
