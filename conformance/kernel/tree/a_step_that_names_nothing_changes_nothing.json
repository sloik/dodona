{
  "kind": "tree",
  "name": "a_step_that_names_nothing_changes_nothing",
  "claim": "C34",
  "covers": [],
  "why": "A step that names something not in the tree, or sets a gate to what it already counts as, changes nothing: the root is hard, so editing it to a gate nobody can read leaves it hard.",
  "policy": {
    "min_hard_gates": 1
  },
  "root": {
    "gate": "hard"
  },
  "children": {
    "k1": {
      "gate": "hard"
    }
  },
  "steps": [
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "root",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "k1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "check": {
          "node": "nope",
          "status": "failed"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "edit": {
          "node": "nope",
          "to": "soft"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "remove": {
          "child": "nope"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "check": {
          "node": "root",
          "status": "maybe"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "edit": {
          "node": "root",
          "to": "optional"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "edit": {
          "node": "root",
          "to": "deferred"
        }
      },
      "expect": {
        "status": "delivered"
      }
    }
  ]
}
