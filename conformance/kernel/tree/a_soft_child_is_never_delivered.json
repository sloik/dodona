{
  "kind": "tree",
  "name": "a_soft_child_is_never_delivered",
  "claim": "C34",
  "covers": [
    "tree/mutant_edit_keeps_confirmation",
    "tree/mutant_soft_child_is_delivered"
  ],
  "why": "Making a child's only criterion soft does not deliver it. A child is an intent and is held to the floor on its own, so with no hard gate it is unguarded, and so is the tree.",
  "policy": {
    "min_hard_gates": 1
  },
  "root": {
    "gate": "hard"
  },
  "children": {
    "k1": {
      "gate": "hard"
    },
    "k2": {
      "gate": "hard"
    }
  },
  "steps": [
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "root",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "node": "k1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "edit": {
          "node": "k2",
          "to": "soft"
        }
      },
      "expect": {
        "status": "draft"
      }
    },
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "unguarded"
      }
    },
    {
      "do": {
        "check": {
          "node": "k2",
          "status": "passed"
        }
      },
      "expect": {
        "status": "unguarded"
      }
    }
  ]
}
