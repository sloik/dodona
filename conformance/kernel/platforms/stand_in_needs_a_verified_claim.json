{
  "kind": "platforms",
  "name": "stand_in_needs_a_verified_claim",
  "claim": "C15",
  "covers": [
    "platforms/mutant_stand_in_unverified",
    "platforms/reach_stand_in"
  ],
  "why": "A record from another platform stands in only after the claim of platform independence has been verified by two platforms agreeing.",
  "stand_in_allowed": true,
  "keys": [
    "k1",
    "k2"
  ],
  "platforms": [
    "p1",
    "p2"
  ],
  "steps": [
    {
      "do": {
        "record": {
          "key": "k2",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k2": {
            "p1": "passed",
            "p2": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k2": "unknown"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k2": {
            "p2": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "unknown"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p2",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k2": {
            "p1": "passed",
            "p2": "passed"
          }
        },
        "stood_in": [
          [
            "k2",
            "p2"
          ]
        ],
        "reproducibility": {
          "k1": "agrees",
          "k2": "unknown"
        }
      }
    }
  ],
  "provider_claims": true
}
