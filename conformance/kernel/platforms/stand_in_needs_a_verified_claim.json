{
  "kind": "platforms",
  "name": "stand_in_needs_a_verified_claim",
  "claim": "C15",
  "covers": [
    "platforms/mutant_stand_in_unverified",
    "platforms/reach_stand_in",
    "platforms/mutant_verified_globally"
  ],
  "why": "A record from another platform stands in only for a key whose result two platforms agree on. Another key agreeing verifies nothing about this one.",
  "stand_in_allowed": true,
  "keys": [
    "k1",
    "k2"
  ],
  "platforms": [
    "p1",
    "p2",
    "p3"
  ],
  "provider_claims": true,
  "steps": [
    {
      "do": {
        "record": {
          "key": "k2",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "unknown",
            "p2": "unknown",
            "p3": "unknown"
          },
          "k2": {
            "p1": "passed",
            "p2": "unknown",
            "p3": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "unknown",
          "k2": "unknown"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "unknown",
            "p3": "unknown"
          },
          "k2": {
            "p1": "passed",
            "p2": "unknown",
            "p3": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "unknown",
          "k2": "unknown"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p2",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "passed",
            "p3": "passed"
          },
          "k2": {
            "p1": "passed",
            "p2": "unknown",
            "p3": "unknown"
          }
        },
        "stood_in": [
          [
            "k1",
            "p3"
          ]
        ],
        "reproducibility": {
          "k1": "agrees",
          "k2": "unknown"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k2",
          "platform": "p2",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "passed",
            "p3": "passed"
          },
          "k2": {
            "p1": "passed",
            "p2": "passed",
            "p3": "passed"
          }
        },
        "stood_in": [
          [
            "k1",
            "p3"
          ],
          [
            "k2",
            "p3"
          ]
        ],
        "reproducibility": {
          "k1": "agrees",
          "k2": "agrees"
        }
      }
    }
  ]
}
