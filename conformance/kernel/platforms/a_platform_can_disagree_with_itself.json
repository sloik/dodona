{
  "kind": "platforms",
  "name": "a_platform_can_disagree_with_itself",
  "claim": "C15",
  "covers": [
    "platforms/mutant_latest_only_filed",
    "platforms/mutant_self_disagreement_ignored",
    "platforms/reach_self_conflict"
  ],
  "why": "Checking again on the same platform can give the other verdict. That platform's own status is then a conflict, which a later record does not undo, and the key's reproducibility differs.",
  "stand_in_allowed": true,
  "keys": [
    "k1"
  ],
  "platforms": [
    "p1",
    "p2"
  ],
  "provider_claims": true,
  "steps": [
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "unknown"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p2",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "passed"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "agrees"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "failed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "conflict",
            "p2": "passed"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "differs"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "conflict",
            "p2": "passed"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "differs"
        }
      }
    }
  ]
}
