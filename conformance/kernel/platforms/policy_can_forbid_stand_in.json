{
  "kind": "platforms",
  "name": "policy_can_forbid_stand_in",
  "claim": "C15",
  "covers": [
    "platforms/mutant_always_stand_in"
  ],
  "why": "Policy can forbid any record from standing in for another platform: a key two platforms agree on still has no status on the third.",
  "stand_in_allowed": false,
  "keys": [
    "k1",
    "k2"
  ],
  "platforms": [
    "p1",
    "p2",
    "p3"
  ],
  "steps": [
    {
      "do": {
        "record": {
          "key": "k2",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k2": {
            "p2": "unknown",
            "p3": "unknown"
          }
        },
        "stood_in": []
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "stood_in": []
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p2",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "passed",
            "p3": "unknown"
          },
          "k2": {
            "p1": "passed",
            "p2": "unknown",
            "p3": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "agrees",
          "k2": "unknown"
        }
      }
    }
  ]
}
