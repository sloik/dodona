{
  "kind": "platforms",
  "name": "no_claim_no_stand_in",
  "claim": "C15",
  "covers": [
    "platforms/mutant_stand_in_unclaimed",
    "platforms/design_not_claimed"
  ],
  "why": "A record stands in only for a provider that claims its results do not depend on the platform: with no claim, a key two platforms agree on still has no status on the third.",
  "stand_in_allowed": true,
  "provider_claims": false,
  "keys": [
    "k1",
    "k2"
  ],
  "platforms": [
    "p1",
    "p2",
    "p3"
  ],
  "steps": [
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "stood_in": []
      }
    },
    {
      "do": {
        "record": {
          "key": "k1",
          "platform": "p2",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k1": {
            "p1": "passed",
            "p2": "passed",
            "p3": "unknown"
          }
        },
        "stood_in": [],
        "reproducibility": {
          "k1": "agrees"
        }
      }
    },
    {
      "do": {
        "record": {
          "key": "k2",
          "platform": "p1",
          "verdict": "passed"
        }
      },
      "expect": {
        "status": {
          "k2": {
            "p1": "passed",
            "p2": "unknown",
            "p3": "unknown"
          }
        },
        "stood_in": []
      }
    }
  ]
}
