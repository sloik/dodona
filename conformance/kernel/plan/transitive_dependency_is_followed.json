{
  "kind": "plan",
  "name": "transitive_dependency_is_followed",
  "claim": "C9",
  "covers": [
    "planner/mutant_direct_deps_only"
  ],
  "why": "A check of d1 depends on d2 as well, because d1 does. Editing d2 makes everything about d1 stale.",
  "granularity": "definition",
  "definitions": {
    "d1": {
      "depends_on": [
        "d2"
      ],
      "file": "f1"
    },
    "d2": {
      "depends_on": [],
      "file": "f2"
    },
    "d3": {
      "depends_on": [],
      "file": "f2"
    }
  },
  "obligations": {
    "check": {
      "targets": [
        "d1"
      ]
    },
    "build": {
      "targets": [
        "d1"
      ],
      "tool": "compiler"
    },
    "test": {
      "artifact_of": "build",
      "tool": "runner"
    }
  },
  "start": {
    "content": {
      "d1": "a",
      "d2": "a",
      "d3": "a"
    },
    "tools": {
      "compiler": "c1",
      "runner": "r1"
    }
  },
  "steps": [
    {
      "do": {
        "run": {
          "obligation": "check"
        }
      },
      "expect": {
        "ran": true,
        "plan": [
          "build",
          "test"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "build"
        }
      },
      "expect": {
        "ran": true,
        "plan": [
          "test"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "test"
        }
      },
      "expect": {
        "ran": true,
        "plan": []
      }
    },
    {
      "do": {
        "edit": {
          "definition": "d2",
          "to": "b"
        }
      },
      "expect": {
        "plan": [
          "build",
          "check",
          "test"
        ]
      }
    }
  ]
}
