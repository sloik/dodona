{
  "kind": "plan",
  "name": "file_identity_costs_a_rerun",
  "claim": "C8",
  "covers": [
    "planner/file_costs_reruns"
  ],
  "why": "With file-level identity, editing an unrelated definition in the same file as a dependency does plan a rerun. That is the cost of coarse identity, and it is only a cost.",
  "granularity": "file",
  "definitions": {
    "d1": {
      "depends_on": [
        "d2"
      ],
      "file": "f1"
    },
    "d2": {
      "depends_on": [],
      "file": "f2"
    },
    "d3": {
      "depends_on": [],
      "file": "f2"
    }
  },
  "obligations": {
    "check": {
      "targets": [
        "d1"
      ]
    },
    "build": {
      "targets": [
        "d1"
      ],
      "tool": "compiler"
    },
    "test": {
      "artifact_of": "build",
      "tool": "runner"
    }
  },
  "start": {
    "content": {
      "d1": "a",
      "d2": "a",
      "d3": "a"
    },
    "tools": {
      "compiler": "c1",
      "runner": "r1"
    }
  },
  "steps": [
    {
      "do": {
        "run": {
          "obligation": "check"
        }
      },
      "expect": {
        "ran": true,
        "plan": [
          "build",
          "test"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "build"
        }
      },
      "expect": {
        "ran": true,
        "plan": [
          "test"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "test"
        }
      },
      "expect": {
        "ran": true,
        "plan": []
      }
    },
    {
      "do": {
        "edit": {
          "definition": "d3",
          "to": "b"
        }
      },
      "expect": {
        "plan": [
          "build",
          "check",
          "test"
        ]
      }
    },
    {
      "do": {
        "edit": {
          "definition": "d3",
          "to": "a"
        }
      },
      "expect": {
        "plan": []
      }
    }
  ]
}
