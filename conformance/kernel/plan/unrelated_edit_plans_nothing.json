{
  "kind": "plan",
  "name": "unrelated_edit_plans_nothing",
  "claim": "C9",
  "covers": [
    "planner/mutant_plan_everything",
    "planner/mutant_plan_nothing",
    "planner/reach_all_current"
  ],
  "why": "With per-definition identity, editing a definition nothing depends on plans nothing, and a tool change plans only what uses the tool.",
  "granularity": "definition",
  "definitions": {
    "d1": {
      "depends_on": [
        "d2"
      ],
      "file": "f1"
    },
    "d2": {
      "depends_on": [],
      "file": "f2"
    },
    "d3": {
      "depends_on": [],
      "file": "f2"
    }
  },
  "obligations": {
    "check": {
      "targets": [
        "d1"
      ]
    },
    "build": {
      "targets": [
        "d1"
      ],
      "tool": "compiler"
    },
    "test": {
      "artifact_of": "build",
      "tool": "runner"
    }
  },
  "start": {
    "content": {
      "d1": "a",
      "d2": "a",
      "d3": "a"
    },
    "tools": {
      "compiler": "c1",
      "runner": "r1"
    }
  },
  "steps": [
    {
      "do": {
        "run": {
          "obligation": "check"
        }
      },
      "expect": {
        "ran": true,
        "plan": [
          "build",
          "test"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "build"
        }
      },
      "expect": {
        "ran": true,
        "plan": [
          "test"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "test"
        }
      },
      "expect": {
        "ran": true,
        "plan": []
      }
    },
    {
      "do": {
        "edit": {
          "definition": "d3",
          "to": "b"
        }
      },
      "expect": {
        "plan": []
      }
    },
    {
      "do": {
        "repin": {
          "tool": "runner",
          "to": "r2"
        }
      },
      "expect": {
        "plan": [
          "test"
        ]
      }
    }
  ]
}
