{
  "kind": "plan",
  "name": "a_step_that_names_nothing_changes_nothing",
  "claim": "C9",
  "covers": [],
  "why": "A step that names a definition, a tool or an obligation the scenario does not have changes nothing, and running an obligation that does not exist runs nothing.",
  "granularity": "definition",
  "definitions": {
    "d1": {
      "depends_on": [],
      "file": "f1"
    }
  },
  "obligations": {
    "build": {
      "targets": [
        "d1"
      ],
      "tool": "compiler"
    }
  },
  "start": {
    "content": {
      "d1": "a"
    },
    "tools": {
      "compiler": "c1"
    }
  },
  "steps": [
    {
      "do": {
        "run": {
          "obligation": "build"
        }
      },
      "expect": {
        "ran": true,
        "plan": []
      }
    },
    {
      "do": {
        "edit": {
          "definition": "nope",
          "to": "b"
        }
      },
      "expect": {
        "plan": []
      }
    },
    {
      "do": {
        "repin": {
          "tool": "nope",
          "to": "x"
        }
      },
      "expect": {
        "plan": []
      }
    },
    {
      "do": {
        "run": {
          "obligation": "nope"
        }
      },
      "expect": {
        "ran": false,
        "plan": []
      }
    },
    {
      "do": {
        "edit": {
          "definition": "d1",
          "to": "b"
        }
      },
      "expect": {
        "plan": [
          "build"
        ]
      }
    },
    {
      "do": {
        "run": {
          "obligation": "nope"
        }
      },
      "expect": {
        "ran": false,
        "plan": [
          "build"
        ]
      }
    }
  ]
}
