      "gate": "hard"
    },
    "c2": {
      "gate": "hard"
    },
    "c3": {
      "gate": "deferred"
    }
  },
  "steps": [
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "criterion": "c1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "criterion": "c2",
          "status": "passed"
        }
      },
