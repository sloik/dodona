{
  "kind": "intent",
  "name": "stale_check_reopens",
  "claim": "C23",
  "covers": [],
  "why": "When a check behind a hard gate goes stale, the intent is open again.",
  "policy": {
    "exception_separation": "apart",
    "min_hard_gates": 1
  },
  "criteria": {
    "c1": {
      "gate": "hard"
    },
    "c2": {
      "gate": "hard"
    },
    "c3": {
      "gate": "deferred"
    }
  },
  "steps": [
    {
      "do": {
        "confirm": {}
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "criterion": "c1",
          "status": "passed"
        }
      },
      "expect": {
        "status": "open"
      }
    },
    {
      "do": {
        "check": {
          "criterion": "c2",
          "status": "passed"
        }
      },
      "expect": {
        "status": "delivered"
      }
    },
    {
      "do": {
        "check": {
          "criterion": "c1",
          "status": "unknown"
        }
      },
      "expect": {
        "status": "open"
      }
    }
  ]
}
