{
  "about": "Defects to plant in this kernel, one at a time, to measure whether the conformance kit rejects a kernel that has them. Each replaces one piece of source text. `model_case` names the planted defect in the formal models that it repeats, where there is one. tools/kit_adequacy.py applies them to a copy; the source here is never changed.",
  "defects": [
    {
      "name": "key leaves out the tool",
      "model_case": "kernel/mutant_key_omits_tool",
      "file": "src/evidence.rs",
      "find": "        tool: tool.into(),",
      "replace": "        tool: String::new(),"
    },
    {
      "name": "result filed under the key at completion",
      "model_case": "kernel/mutant_complete_with_current_key",
      "file": "src/evidence.rs",
      "find": "            attempt.outcome = x.get(\"verdict\").str().into()",
      "replace": "            attempt.key = key(&attempt.key.obligation.clone(), obligations, &defs, &tool);\n            attempt.outcome = x.get(\"verdict\").str().into()"
    },
    {
      "name": "unavailable recorded as passed",
      "model_case": "kernel/mutant_unavailable_is_pass",
      "file": "src/evidence.rs",
      "find": "if up { \"pending\" } else { \"unavailable\" }",
      "replace": "if up { \"pending\" } else { \"passed\" }"
    },
    {
      "name": "pass outranks fail",
      "model_case": "kernel/mutant_pass_outranks_fail",
      "file": "src/evidence.rs",
      "find": "(true, true) => \"conflict\",",
      "replace": "(true, true) => \"passed\","
    },
    {
      "name": "lost run recorded as passed",
      "model_case": null,
      "file": "src/evidence.rs",
      "find": "            attempt.outcome = \"error\".into()",
      "replace": "            attempt.outcome = \"passed\".into()"
    },
    {
      "name": "draft is delivered",
      "model_case": "intent/mutant_draft_delivers",
      "file": "src/intent.rs",
      "find": "if !confirmed {",
      "replace": "if false {"
    },
    {
      "name": "unguarded is delivered",
      "model_case": "intent/mutant_unguarded_delivers",
      "file": "src/intent.rs",
      "find": "count() as i64) < min {",
      "replace": "count() as i64) < 0 {"
    },
    {
      "name": "unknown hard gate passes",
      "model_case": "intent/mutant_delivered_ignores_unknown",
      "file": "src/intent.rs",
      "find": "any(|(g, s)| g == \"hard\" && s != \"passed\")",
      "replace": "any(|(g, s)| g == \"hard\" && s == \"failed\")"
    },
    {
      "name": "deferred gate ignored",
      "model_case": "intent/mutant_deferred_as_passed",
      "file": "src/intent.rs",
      "find": "        .any(|(g, s)| g == \"deferred\" && s != \"passed\")",
      "replace": "        .any(|(g, s)| g == \"deferred\" && s == \"never\")"
    },
    {
      "name": "edit keeps confirmation",
      "model_case": "intent/mutant_edit_keeps_confirmation",
      "file": "src/intent.rs",
      "find": "            criteria.get_mut(a.get(\"criterion\").str()).unwrap().0 = a.get(\"to\").str().into();\n            confirmed = false",
      "replace": "            criteria.get_mut(a.get(\"criterion\").str()).unwrap().0 = a.get(\"to\").str().into();"
    },
    {
      "name": "worker's exception takes effect",
      "model_case": "intent/mutant_worker_can_amend",
      "file": "src/intent.rs",
      "find": "owner && rank(level) >= floor",
      "replace": "rank(level) >= floor"
    },
    {
      "name": "nothing recorded treated as apart",
      "model_case": "intent/mutant_missing_is_apart",
      "file": "src/intent.rs",
      "find": "unwrap_or(\"self\")",
      "replace": "unwrap_or(\"apart\")"
    },
    {
      "name": "floor ignored",
      "model_case": "intent/mutant_below_floor_counts",
      "file": "src/intent.rs",
      "find": "owner && rank(level) >= floor",
      "replace": "owner"
    },
    {
      "name": "worker keeps the level it wrote",
      "model_case": "intent/mutant_worker_keeps_level",
      "file": "src/intent.rs",
      "find": "    } else {\n        \"self\"\n    };\n    (owner && rank(level)",
      "replace": "    } else {\n        a.opt(\"claims\").map(Value::str).unwrap_or(\"self\")\n    };\n    (owner && rank(level)"
    },
    {
      "name": "level shown higher than used",
      "model_case": "intent/mutant_hide_level",
      "file": "src/intent.rs",
      "find": "(\"level\", json::string(level)),",
      "replace": "(\"level\", json::string(\"apart\")),"
    },
    {
      "name": "declared counts in full",
      "model_case": "intent/mutant_declared_counts_in_full",
      "file": "src/intent.rs",
      "find": "                \"helper\"\n            };",
      "replace": "                \"credentialed\"\n            };"
    },
    {
      "name": "direct deps only",
      "model_case": "planner/mutant_direct_deps_only",
      "file": "src/plan.rs",
      "find": "            closure(t.str(), defs, &mut names);",
      "replace": "            names.insert(t.str().into());"
    },
    {
      "name": "key omits producer",
      "model_case": "planner/mutant_key_omits_producer",
      "file": "src/plan.rs",
      "find": "        parts.push(key(producer.str(), input, content, tools));",
      "replace": "        let _ = producer;"
    },
    {
      "name": "plan everything",
      "model_case": "planner/mutant_plan_everything",
      "file": "src/plan.rs",
      "find": ".filter(|(name, _)| !done.contains(&(name.clone(), key(name, input, content, tools))))",
      "replace": ".filter(|(name, _)| { let _ = (done, name, content, tools); true })"
    },
    {
      "name": "average",
      "model_case": "assurance/mutant_average",
      "file": "src/assurance.rs",
      "find": "        .min()\n        .unwrap();",
      "replace": "        .sum::<usize>() / 3;"
    },
    {
      "name": "ignore unreported",
      "model_case": "assurance/mutant_ignore_unreported",
      "file": "src/assurance.rs",
      "find": ".unwrap_or(\"none\");",
      "replace": ".unwrap_or(\"proven\");"
    },
    {
      "name": "unknown defect counts",
      "model_case": "assurance/mutant_unknown_defect_counts",
      "file": "src/assurance.rs",
      "find": "v.str() == \"passed\"",
      "replace": "v.str() != \"failed\""
    },
    {
      "name": "empty is shown",
      "model_case": "assurance/mutant_empty_is_shown",
      "file": "src/assurance.rs",
      "find": "        \"none-planted\"",
      "replace": "        \"shown\""
    },
    {
      "name": "remove keeps confirmation",
      "model_case": "tree/mutant_remove_keeps_confirmation",
      "file": "src/tree.rs",
      "find": "                children.remove(r.get(\"child\").str());\n                confirmed = false;",
      "replace": "                children.remove(r.get(\"child\").str());"
    },
    {
      "name": "add keeps confirmation",
      "model_case": "tree/mutant_add_keeps_confirmation",
      "file": "src/tree.rs",
      "find": "                confirmed = false;\n            }\n            json::object",
      "replace": "            }\n            json::object"
    },
    {
      "name": "delivered ignores children",
      "model_case": "tree/mutant_delivered_ignores_children",
      "file": "src/tree.rs",
      "find": "|| children.values().any(|(g, s)| g != \"hard\" || s != \"passed\")",
      "replace": "|| false"
    },
    {
      "name": "soft child is delivered",
      "model_case": "tree/mutant_soft_child_is_delivered",
      "file": "src/tree.rs",
      "find": "g != \"hard\" || s != \"passed\"",
      "replace": "g == \"hard\" && s != \"passed\""
    },
    {
      "name": "latest only",
      "model_case": "attempts/mutant_latest_only",
      "file": "src/attempts.rs",
      "find": "attempts.iter().all(|(_, r)| r == \"agreed\")",
      "replace": "attempts.last().unwrap().1 == \"agreed\""
    },
    {
      "name": "open ignored",
      "model_case": "attempts/mutant_open_ignored",
      "file": "src/attempts.rs",
      "find": "r == \"agreed\") {",
      "replace": "r == \"agreed\" || r == \"open\") {"
    },
    {
      "name": "flag does not cap",
      "model_case": "attempts/mutant_flag_does_not_cap",
      "file": "src/attempts.rs",
      "find": "if shopped {\n                        json::string(\"helper\")",
      "replace": "if false {\n                        json::string(\"helper\")"
    },
    {
