      "find": "if allowed && verified {",
      "replace": "if { let _ = (allowed, verified); true } {"
    },
    {
      "name": "stand in unverified",
      "model_case": "platforms/mutant_stand_in_unverified",
      "file": "src/platforms.rs",
      "find": "if allowed && verified {",
      "replace": "if allowed { let _ = verified;"
    },
    {
      "name": "one platform reproduces",
      "model_case": "platforms/mutant_one_platform_reproduces",
      "file": "src/platforms.rs",
      "find": "if values.len() < 2 {",
      "replace": "if values.is_empty() {"
    },
    {
      "name": "disagreement ignored",
