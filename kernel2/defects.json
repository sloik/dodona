{
  "about": "Planted defects for kernel2. Each entry is one exact text replacement in one file that makes the kernel wrong in one way the conformance kit is meant to catch. plant.js applies them one at a time to a temporary copy.",
  "defects": [
    {
      "name": "key leaves out the tool",
      "model_case": "kernel/mutant_key_omits_tool",
      "file": "evidence.js",
      "find": "    && entry.tool === current.tool\n",
      "replace": ""
    },
    {
      "name": "a result filed under the inputs at completion instead of at submission",
      "model_case": "kernel/mutant_complete_with_current_key",
      "file": "evidence.js",
      "find": "inputs: run.inputs, tool: run.tool, verdict: step.complete.verdict",
      "replace": "inputs: inputsOf(state.definitions, dependsOn(run.obligation)), tool: state.tool, verdict: step.complete.verdict"
    },
    {
      "name": "unavailable recorded as passed",
      "model_case": "kernel/mutant_unavailable_is_pass",
      "file": "evidence.js",
      "find": "ledger.outcomes.push({ ...entry, outcome: 'unavailable' });",
      "replace": "ledger.records.push({ ...entry, verdict: 'passed' });"
    },
    {
      "name": "pass outranks fail",
      "model_case": "kernel/mutant_pass_outranks_fail",
      "file": "evidence.js",
      "find": "if (anyPassed && anyFailed) return { status: 'conflict', pending: false, reason: null };",
      "replace": ""
    },
    {
      "name": "lost run recorded as passed",
      "model_case": "(none named in the kit)",
      "file": "evidence.js",
      "find": "ledger.outcomes.push({ obligation: run.obligation, inputs: run.inputs, tool: run.tool, outcome: 'error' });",
      "replace": "ledger.records.push({ obligation: run.obligation, inputs: run.inputs, tool: run.tool, verdict: 'passed' });"
    },
    {
      "name": "draft is delivered",
      "model_case": "intent/mutant_draft_delivers",
      "file": "intent.js",
      "find": "  if (!confirmed) return 'draft';\n",
      "replace": ""
    },
    {
      "name": "unguarded is delivered",
      "model_case": "intent/mutant_unguarded_delivers",
      "file": "intent.js",
      "find": "  if (hard.length < policy.min_hard_gates) return 'unguarded';\n",
      "replace": ""
    },
    {
      "name": "unknown hard gate passes",
      "model_case": "intent/mutant_delivered_ignores_unknown",
      "file": "intent.js",
      "find": "hard.some((criterion) => criterion.check !== 'passed')",
      "replace": "hard.some((criterion) => criterion.check === 'failed' || criterion.check === 'conflict')"
    },
    {
      "name": "deferred gate ignored",
      "model_case": "intent/mutant_deferred_as_passed",
      "file": "intent.js",
      "find": "if (deferred.every((criterion) => criterion.check === 'passed')) return 'fulfilled';",
      "replace": "return 'fulfilled';"
    },
    {
      "name": "edit keeps confirmation",
      "model_case": "intent/mutant_edit_keeps_confirmation",
      "file": "intent.js",
      "find": "step.edit.to;\n      confirmed = false;",
      "replace": "step.edit.to;"
    },
    {
      "name": "worker's exception takes effect",
      "model_case": "intent/mutant_worker_can_amend",
      "file": "intent.js",
      "find": "amendment.by === 'owner' && rank(level)",
      "replace": "rank(level)"
    },
    {
      "name": "nothing claimed treated as apart",
      "model_case": "intent/mutant_missing_is_apart",
      "file": "intent.js",
      "find": "amendment.claims === null) return 'self';",
      "replace": "amendment.claims === null) return 'apart';"
    },
    {
      "name": "floor ignored",
      "model_case": "intent/mutant_below_floor_counts",
      "file": "intent.js",
      "find": " && rank(level) >= rank(policy.exception_separation);",
      "replace": ";"
    },
    {
      "name": "worker keeps the level it claims",
      "model_case": "intent/mutant_worker_keeps_level",
      "file": "intent.js",
      "find": "  if (amendment.by === 'worker') return 'self';\n",
      "replace": ""
    },
    {
      "name": "level shown higher than used",
      "model_case": "intent/mutant_hide_level",
      "file": "intent.js",
      "find": "return { takes_effect: takesEffect, level };",
      "replace": "return { takes_effect: takesEffect, level: amendment.claims || level };"
    },
    {
      "name": "a declared claim counted in full",
      "model_case": "intent/mutant_declared_counts_in_full",
      "file": "intent.js",
      "find": "declared: 'helper'",
      "replace": "declared: 'credentialed'"
    },
    {
      "name": "plan follows only direct targets",
      "model_case": "planner/mutant_direct_deps_only",
      "file": "plan.js",
      "find": "    pending.push(...definitions[name].depends_on);\n",
      "replace": ""
    },
    {
      "name": "a test's inputs leave out the build it tests",
      "model_case": "planner/mutant_key_omits_producer",
      "file": "plan.js",
      "find": "if (details.artifact_of !== undefined) inputs.push",
      "replace": "if (false) inputs.push"
    },
    {
      "name": "everything always planned",
      "model_case": "planner/mutant_plan_everything",
      "file": "plan.js",
      "find": ".filter((obligation) => !hasResult(scenario, state, results, obligation))",
      "replace": ".filter(() => true)"
    },
    {
      "name": "shown level is the average",
      "model_case": "assurance/mutant_average",
      "file": "assurance.js",
      "find": "SCALE[Math.min(...LINKS.map((link) => levelOf(links, link)))]",
      "replace": "SCALE[Math.floor(LINKS.map((link) => levelOf(links, link)).reduce((a, b) => a + b, 0) / LINKS.length)]"
    },
    {
      "name": "an unreported link left out of the minimum",
      "model_case": "assurance/mutant_ignore_unreported",
      "file": "assurance.js",
      "find": "Math.min(...LINKS.map(",
      "replace": "Math.min(...LINKS.filter((link) => links[link]).map("
    },
    {
      "name": "unknown planted defect counts as caught",
      "model_case": "assurance/mutant_unknown_defect_counts",
      "file": "assurance.js",
      "find": "statuses.every((status) => status === 'passed')",
      "replace": "statuses.every((status) => status !== 'failed')"
    },
    {
      "name": "no planted defect reported as shown",
      "model_case": "assurance/mutant_empty_is_shown",
      "file": "assurance.js",
      "find": "return 'none-planted';",
      "replace": "return 'shown';"
    },
    {
      "name": "removing a child keeps the tree confirmed",
      "model_case": "tree/mutant_remove_keeps_confirmation",
      "file": "tree.js",
      "find": "children.delete(step.remove.child);\n      confirmed = false;",
      "replace": "children.delete(step.remove.child);"
    },
    {
      "name": "adding a child keeps it confirmed",
      "model_case": "tree/mutant_add_keeps_confirmation",
      "file": "tree.js",
      "find": "check: 'unknown' });\n      confirmed = false;\n    }\n    results",
      "replace": "check: 'unknown' });\n    }\n    results"
    },
    {
      "name": "root delivered whatever its children",
      "model_case": "tree/mutant_delivered_ignores_children",
      "file": "tree.js",
      "find": "if (hard.some((node) => node.check !== 'passed')) return 'open';",
      "replace": "if (root.check !== 'passed') return 'open';"
    },
    {
      "name": "soft child counts as delivered",
      "model_case": "tree/mutant_soft_child_is_delivered",
      "file": "tree.js",
      "find": "  if (children.some((child) => child.gate !== 'hard')) return 'open';\n",
      "replace": ""
    },
    {
      "name": "only the latest attempt counts",
      "model_case": "attempts/mutant_latest_only",
      "file": "attempts.js",
      "find": "return attempts.every((attempt) => attempt.state === 'agreed') ? 'agreed' : 'refused';",
      "replace": "return attempts[attempts.length - 1].state === 'agreed' ? 'agreed' : 'refused';"
    },
    {
      "name": "open attempt ignored",
      "model_case": "attempts/mutant_open_ignored",
      "file": "attempts.js",
      "find": "return attempts.every((attempt) => attempt.state === 'agreed') ? 'agreed' : 'refused';",
      "replace": "return attempts.every((attempt) => attempt.state !== 'refused') ? 'agreed' : 'refused';"
    },
    {
      "name": "shopping flagged but not capping",
      "model_case": "attempts/mutant_flag_does_not_cap",
      "file": "attempts.js",
      "find": "cap: shopped ? 'helper' : null",
      "replace": "cap: null"
    },
    {
      "name": "shopping never flagged",
      "model_case": "attempts/mutant_flag_missed",
      "file": "attempts.js",
      "find": "const shopped = isShopped(attempts);",
      "replace": "const shopped = false;"
    },
    {
      "name": "a record always stands in",
      "model_case": "platforms/mutant_always_stand_in",
      "file": "platforms.js",
      "find": "scenario.stand_in_allowed && verified && others.length > 0",
      "replace": "verified && others.length > 0"
    },
    {
      "name": "a record stands in unverified",
      "model_case": "platforms/mutant_stand_in_unverified",
      "file": "platforms.js",
      "find": "scenario.stand_in_allowed && verified && others.length > 0",
      "replace": "scenario.stand_in_allowed && others.length > 0"
    },
    {
      "name": "one platform alone reproduced",
      "model_case": "platforms/mutant_one_platform_reproduces",
      "file": "platforms.js",
      "find": "if (platformsAgree(verdicts, key)) return 'passed';",
      "replace": "if (verdictsOf(verdicts, key).includes('passed')) return 'passed';"
    },
    {
      "name": "disagreement not a failure",
      "model_case": "platforms/mutant_disagreement_ignored",
      "file": "platforms.js",
      "find": "  if (platformsDiffer(verdicts, key)) return 'failed';\n",
      "replace": ""
    },
    {
      "name": "decision flagged only when its content exists nowhere",
      "model_case": "decisions/mutant_identities_without_names",
      "file": "decisions.js",
      "find": "return now !== recorded;",
      "replace": "return ![...names.values()].includes(recorded);"
    },
    {
      "name": "a name that disappears not flagged",
      "model_case": "decisions/mutant_gone_is_not_flagged",
      "file": "decisions.js",
      "find": "names.has(governs) ? names.get(governs) : null;",
      "replace": "names.has(governs) ? names.get(governs) : recorded;"
    }
  ]
}
