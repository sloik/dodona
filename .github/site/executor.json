{
  "about": "Site binding for this repository's own CI (decision 0023). It says where model checks run for the dodona project itself. It is not part of dodona's design, and another site would supply its own file.",
  "command": [
    "/usr/local/bin/tla-queue",
    "run",
    "--project",
    "sloik/dodona",
    "--source",
    "{source}",
    "{includes}",
    "--timeout",
    "{timeout}",
    "--",
    "{tool}"
  ],
  "include_flag": "--include",
  "tool": [
    "/usr/bin/java",
    "-cp",
    "/opt/tla/tla2tools-1.7.4.jar",
    "tlc2.TLC"
  ],
  "timeout_seconds": 2400,
  "batch_command": [
    "/usr/local/bin/tla-queue",
    "run",
    "--project",
    "sloik/dodona",
    "--source",
    "{source}",
    "--output",
    "out",
    "--fetch",
    "{dest}",
    "--timeout",
    "{timeout}",
    "--",
    "/usr/bin/python3",
    "-I",
    "batch_driver.py",
    "manifest.json"
  ],
  "batch_timeout_seconds": 3600
}
